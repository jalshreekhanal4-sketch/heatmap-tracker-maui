<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true">

    <!-- Google Maps requires an API key. It is substituted at build time from the
         MapsApiKey property in maps.props, which is not tracked by git so the key
         never reaches the public repository. See maps.props.example. -->
    <meta-data android:name="com.google.android.geo.API_KEY"
               android:value="${MAPS_API_KEY}" />
  </application>

  <!-- Coarse and fine location are both requested: Android 12 and later let the user
       grant only approximate location, and the app still works in that case. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Declares that GPS hardware is preferred but not mandatory, so the app remains
       installable on devices without it. -->
  <uses-feature android:name="android.hardware.location.gps" android:required="false" />

</manifest>
